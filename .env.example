# Adresse d'envoi du formulaire de contact. Vide en développement : le formulaire prépare
# un e-mail pré-rempli. En production : https://app.fdastudio.fr/api/public/leads par défaut.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Clé PUBLIQUE du captcha Cloudflare Turnstile (la clé secrète reste sur Vercel, outil interne).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
